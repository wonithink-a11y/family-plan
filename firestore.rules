rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 기기 ID -> 가족코드 백업: 문서 단위 get/쓰기만 허용, 목록 조회·삭제 금지
    match /_device_codes/{did} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.keys().hasOnly(['familyCode','savedAt'])
                            && request.resource.data.familyCode is string
                            && request.resource.data.familyCode.size() >= 2
                            && request.resource.data.familyCode.size() <= 50;
      allow list, delete: if false;
    }

    // 가족 데이터: 로그인(익명) + 가족코드를 아는 사람만. families 루트 문서/목록 조회 금지
    match /families/{code} {
      allow read, write: if false;

      // 일반 하위 컬렉션(items, events, meta, routine, stamps, coupons, preps, devices, 앞으로 추가될 것 포함):
      // 익명 로그인 + 문서 크기 제한. images/config 는 아래에서 형식을 따로 검증하므로 여기서 제외한다.
      match /{sub}/{doc=**} {
        allow read, delete: if request.auth != null && sub != 'images' && sub != 'config';
        allow create, update: if request.auth != null && sub != 'images' && sub != 'config'
          && request.resource.size() < 500000;
      }

      // 첨부 이미지 원본 (JPEG dataURL, 수행평가 문서에는 썸네일만 저장)
      match /images/{id} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id','itemId','data','createdAt'])
          && request.resource.data.data is string
          && request.resource.size() < 700000;
      }

      // 구성원 목록 / 템플릿 / 목표 점수
      match /config/{id} {
        allow read, delete: if request.auth != null && id in ['members','templates','goals'];
        allow create, update: if request.auth != null && id in ['members','templates','goals']
          && request.resource.data.keys().hasOnly(['list'])
          && request.resource.data.list is list
          && request.resource.data.list.size() <= 30
          && request.resource.size() < 200000;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
