rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 기기 ID -> 가족코드 백업: 문서 단위 get/쓰기만 허용, 목록 조회·삭제 금지
    match /_device_codes/{did} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.keys().hasOnly(['familyCode','savedAt'])
                            && request.resource.data.familyCode is string
                            && request.resource.data.familyCode.size() >= 2
                            && request.resource.data.familyCode.size() <= 50;
      allow list, delete: if false;
    }

    // 가족 데이터: 가족코드를 아는 사람만 하위 컬렉션 접근 (families 루트 목록 조회 금지)
    match /families/{code} {
      allow read, write: if false;
      match /{sub}/{doc} {
        allow read, write: if request.auth != null && sub in ['items','events'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
